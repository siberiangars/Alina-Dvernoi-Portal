# Avito API credentials
# Получить на https://developers.avito.ru в разделе «Мессенджер»
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=

# Anthropic Claude API
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram Bot
# Токен от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# ID чата/группы. Узнать через @userinfobot или getUpdates
TELEGRAM_CHAT_ID=

# Интервал опроса Авито в миллисекундах (по умолчанию 15000 = 15 сек)
POLL_INTERVAL_MS=15000
ENABLE_WARMING=false
ENABLE_FOLLOWUPS=false
REPLY_DELAY_MIN_MS=3500
REPLY_DELAY_MAX_MS=9000
COMPANY_PHONE=+7-903-923-00-89
